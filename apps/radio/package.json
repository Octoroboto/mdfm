{
  "name": "mdfm-radio",
  "productName": "MDFM Radio",
  "version": "0.3.1",
  "description": "MDFM 99.9 HD in its own window, with live local weather and sports.",
  "main": "src/main/main.js",
  "private": true,
  "mdfm": {
    "slackRelay": ""
  },
  "scripts": {
    "sync": "node scripts/sync-content.js",
    "start": "node scripts/sync-content.js && electron .",
    "test": "node scripts/sync-content.js && MDFM_TEST=1 node --test test/*.test.js",
    "bouncer:lock": "node scripts/bouncer-lock.js",
    "report": "node scripts/dependency-report.js",
    "build:mac": "bash scripts/build-mac.sh",
    "install:mac": "bash scripts/build-mac.sh --install",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.13.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "@electron/fuses": "2.1.3"
  },
  "build": {
    "appId": "com.rentvision.mdfm-radio",
    "productName": "MDFM Radio",
    "files": [
      "src/**/*",
      "kit/**/*",
      "vendor/**/*",
      "package.json",
      "build/dependency-report.json"
    ],
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "NSLocationUsageDescription": "MDFM Radio uses your location for local weather and sports."
      }
    },
    "copyright": "RentVision media development",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "dmg": {
      "title": "MDFM Radio ${version}"
    }
  },
  "author": "Rob Durland"
}
